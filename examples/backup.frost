#!/usr/bin/env frost
--
-- Archive a folder, verify the archive, and write a manifest.

put item 1 of the arguments into source folder
put item 2 of the arguments into destination folder

if source folder is empty or destination folder is empty then
    put "usage: backup.frost <source> <destination>" into standard error
    quit with status 2
end if

run "date" with "+%Y%m%d-%H%M%S"
put it into stamp

-- Filenames with spaces need no quoting, because arguments are a list.
put destination folder & "/backup-" & stamp & ".tar.gz" into archive path

put "archiving" && source folder
run "tar" with "-czf", archive path, "-C", source folder, "."

if not file (archive path) exists then
    put "archive was not created" into standard error
    quit with status 1
end if

run "tar" with "-tzf", archive path
put the number of lines in it into entry count
put "verified" && entry count && "entries"

put destination folder & "/manifest-" & stamp & ".txt" into manifest path
put "backup of" && source folder into file (manifest path)
put "created" && stamp after file (manifest path)
put "entries" && entry count after file (manifest path)

put "wrote" && archive path
put "wrote" && manifest path
